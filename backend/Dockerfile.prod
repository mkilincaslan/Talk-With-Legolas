FROM node:20-alpine as builder

WORKDIR /app

# Install OpenSSL and build dependencies
RUN apk add --no-cache openssl

# Copy package files
COPY package*.json ./
COPY prisma ./prisma/

# Install all dependencies (including dev dependencies)
RUN npm install

# Copy source code
COPY . .

# Generate Prisma client
RUN npx prisma generate

# Build TypeScript
RUN npm run build

# Install production dependencies and required tools
RUN npm ci --only=production && \
    npm install typescript ts-node @types/node prisma @prisma/client --save-prod

# Create startup script with proper migration and seeding
RUN echo '#!/bin/sh\n\
echo "Waiting for database to be ready..."\n\
sleep 10\n\
echo "Generating Prisma Client..."\n\
npx prisma generate\n\
echo "Running database migrations..."\n\
npx prisma migrate reset --force\n\
echo "Starting application..."\n\
export PORT=${PORT:-3000}\n\
npm run start\n\
' > /app/start.sh && chmod +x /app/start.sh

EXPOSE 3000

# Start the application with migrations
CMD ["/app/start.sh"] 